            "properties": {
                "content": {
                    "type": "string",
                    "maxLength": 1000,
                    "minLength": 3
                },
                "title": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 3
                }
            }
        },
        "article.Meta": {
            "type": "object",
            "properties": {
                "total": {
                    "type": "integer"
                }
            }
